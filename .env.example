# PostgreSQL credentials used by the database and backend containers.
DATABASE_USER=paypal_app
DATABASE_PASSWORD=change-this-password
DATABASE_NAME=paypal
DATABASE_PORT=5432
DATABASE_HOST_PORT=5434

# Public host ports.
BACKEND_HOST_PORT=3001
UI_HOST_PORT=3000

# Receipt-processing model credentials.
MODEL_API_KEY=replace-with-your-model-api-key
MODEL_NAME=deepseek-chat
MODEL_ROUTE=https://api.deepseek.com/v1/chat/completions
MAX_TOKENS=1024

# PayPal sandbox credentials. Use live credentials and PAYPAL_ROUTE only when
# intentionally switching to production.
PAYPAL_CLIENT_ID=replace-with-your-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-your-paypal-client-secret
PAYPAL_ROUTE=https://api-m.sandbox.paypal.com/v2/
PAYPAL_HTTP_DEBUG=0

# Path to the private Z.AI SDK config file mounted into the frontend container.
ZAI_CONFIG_PATH=./.z-ai-config
