# Base URL of the receipt-processing backend (required). On submit the app sends:
#   POST {RECEIPT_BACKEND_URL}/convert
#   { "image": "<base64 of the receipt image>", "prompt": "<allocation instructions>" }
# and the backend's response payload IS the result shown in the app — there
# is no demo fallback. Without this variable, submitting a receipt fails
# with a 503 error.
RECEIPT_BACKEND_URL=http://localhost:3001

# The receipt card's "Send invoice now" action sends:
#   POST {RECEIPT_BACKEND_URL}/invoice
#   { "transaction_number": "<receipt transaction number>" }
# The backend creates and sends a live PayPal invoice to its configured recipient.

# Chat requests also require a separate .z-ai-config JSON file in this
# project directory. The z-ai-web-dev-sdk reads baseUrl (including /v1)
# and apiKey from that file; obtain both values from your AI provider.
# Keep .z-ai-config private and do not commit it.
